generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  SUPERADMIN
  ADMIN
  EMPLOYEE
}

enum PaymentMethod {
  CASH
  TRANSFER
  CREDIT
}

enum MovementStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum MovementType {
  RESTOCK
  TRANSFER
}

// ─────────────────────────────────────────
// USERS
// ─────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  fullName     String
  username     String   @unique
  phone        String
  email        String?  @unique
  passwordHash       String
  mustChangePassword Boolean  @default(false)
  role               Role     @default(EMPLOYEE)
  twoFactorSecret    String?
  twoFactorEnabled   Boolean  @default(false)
  language           String   @default("en")
  tokenVersion       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // relations
  ownedBusinesses Business[]      @relation("BusinessOwner")
  businessUsers   BusinessUser[]
  transactions    Transaction[]
  stockMovements  StockMovement[]
  creditPayments  CreditPayment[]
  auditLogs       AuditLog[]
}

// ─────────────────────────────────────────
// BUSINESSES
// ─────────────────────────────────────────

model Business {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String?
  country   String
  location  String
  currency  String
  ownerId   String
  receiptTitle         String  @default("RECEIPT")
  receiptFooterNote    String  @default("Thank you for your business!")
  receiptShowSignature Boolean @default(true)
  // Low-stock alert rule, applied to any WarehouseStock row that doesn't
  // have its own explicit lowStockThreshold override: lowStockThresholdsByUnit
  // is a { unit: threshold } map (e.g. {"pcs": 50, "dozen": 5}) checked first
  // by the product's unit, falling back to defaultLowStockThreshold for any
  // unit not listed there.
  defaultLowStockThreshold Float @default(10)
  lowStockThresholdsByUnit Json  @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  owner         User           @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  businessUsers BusinessUser[]
  warehouses    Warehouse[]
  products      Product[]
  customers     Customer[]
  transactions  Transaction[]
  auditLogs     AuditLog[]
}

// ─────────────────────────────────────────
// BUSINESS USERS
// ─────────────────────────────────────────

model BusinessUser {
  id         String   @id @default(uuid())
  businessId String
  userId     String
  role       Role
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
}

// ─────────────────────────────────────────
// WAREHOUSES
// ─────────────────────────────────────────

model Warehouse {
  id         String    @id @default(uuid())
  businessId String
  name       String
  location   String?
  isPrimary  Boolean   @default(false)
  // Soft-delete: hidden from active lists/pickers when set, but its stock
  // rows and transaction/stock-movement history are left completely
  // untouched (no cascade fires for a soft-delete).
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stock         WarehouseStock[]
  transactions  Transaction[]
  movementsFrom StockMovement[] @relation("MovementFrom")
  movementsTo   StockMovement[] @relation("MovementTo")
}

// ─────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────

model Product {
  id          String    @id @default(uuid())
  businessId  String
  name        String
  unit        String
  price       Float     @default(0)
  // What this product actually costs the business, distinct from `price`
  // (what it sells for). Null means no cost data recorded - a permanent,
  // legitimate state (not every product's cost is tracked), never treated
  // as zero. SUPERADMIN/ADMIN only - see product.service.js's includeCostPrice.
  costPrice   Float?
  description String?
  shortCode   String?
  // Soft-delete: hidden from the catalog/POS/pickers when set, but past
  // TransactionItem/StockMovement rows still resolve this product fine
  // regardless (no cascade fires for a soft-delete).
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stock            WarehouseStock[]
  transactionItems TransactionItem[]
  stockMovements   StockMovement[]
  units            ProductUnit[]

  @@unique([businessId, shortCode])
}

// ─────────────────────────────────────────
// PRODUCT UNITS (alternate pack sizes, e.g. "dozen" = 12 base units)
// ─────────────────────────────────────────

model ProductUnit {
  id        String @id @default(uuid())
  productId String
  label     String
  factor    Float

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, label])
}

// ─────────────────────────────────────────
// WAREHOUSE STOCK
// ─────────────────────────────────────────

model WarehouseStock {
  id                String   @id @default(uuid())
  warehouseId       String
  productId         String
  quantity          Float    @default(0)
  // Null means "no explicit override" - governed instead by the business's
  // live lowStockThresholdsByUnit/defaultLowStockThreshold rule (resolved at
  // read time, see utils/lowStockThreshold.js), so changing that rule in
  // Settings retroactively affects every row that hasn't been customized.
  lowStockThreshold Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
}

// ─────────────────────────────────────────
// CUSTOMERS
// ─────────────────────────────────────────

model Customer {
  id         String    @id @default(uuid())
  businessId String
  name       String
  // Required so every saved customer is actually reachable/locatable -
  // enforced at the application layer (validators), not just here.
  phone      String
  address    String
  // Soft-delete: hidden from the directory/pickers when set; past
  // transactions keep their `customerName` snapshot regardless.
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([businessId, name])
}

// ─────────────────────────────────────────
// TRANSACTIONS
// ─────────────────────────────────────────

model Transaction {
  id            String        @id @default(uuid())
  businessId    String
  warehouseId   String
  performedById String
  customerId    String?
  paymentMethod PaymentMethod
  totalAmount   Float
  customerName  String        @default("Casual Customer")
  notes         String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  // Only ever set for CASH sales where the cashier chose to record what the
  // customer physically handed over - null for TRANSFER/CREDIT, and null for
  // CASH sales too if the amount received just wasn't entered.
  amountTendered Float?
  changeGiven    Float?

  business      Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  warehouse     Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  performedBy   User            @relation(fields: [performedById], references: [id], onDelete: Cascade)
  customer      Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         TransactionItem[]
  payments      CreditPayment[]
}

// ─────────────────────────────────────────
// CREDIT PAYMENTS
// ─────────────────────────────────────────

model CreditPayment {
  id            String   @id @default(uuid())
  transactionId String
  amount        Float
  recordedById  String
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  recordedBy  User        @relation(fields: [recordedById], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// TRANSACTION ITEMS
// ─────────────────────────────────────────

model TransactionItem {
  id              String  @id @default(uuid())
  transactionId   String
  productId       String
  quantitySold    Float
  unitPrice       Float
  subtotal        Float
  discountPercent Float?
  // Snapshot of Product.costPrice at time of sale (base-unit terms, same as
  // unitPrice) - null if the product had no cost price recorded then. Never
  // rewritten by a later cost-price edit, same reasoning as unitPrice/unitLabel.
  costPrice       Float?
  // Display-only: the pack size actually rung up (e.g. "dozen" x 2), when
  // it wasn't the product's base unit. quantitySold/unitPrice/subtotal
  // above are always in base-unit terms regardless of what's shown here.
  unitLabel       String?
  unitQuantity    Float?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// STOCK MOVEMENTS
// ─────────────────────────────────────────

model StockMovement {
  id              String         @id @default(uuid())
  businessId      String
  fromWarehouseId String?
  toWarehouseId   String
  productId       String
  quantity        Float
  // Display-only: the pack size actually entered (e.g. "carton" x 3), when
  // it wasn't the product's base unit. `quantity` above is always the
  // base-unit amount actually applied to WarehouseStock.
  unitLabel       String?
  unitQuantity    Float?
  type            MovementType   @default(TRANSFER)
  status          MovementStatus @default(COMPLETED)
  movedById       String
  notes           String?
  createdAt       DateTime       @default(now())

  movedBy       User       @relation(fields: [movedById], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse? @relation("MovementFrom", fields: [fromWarehouseId], references: [id], onDelete: Cascade)
  toWarehouse   Warehouse  @relation("MovementTo", fields: [toWarehouseId], references: [id], onDelete: Cascade)
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────
// AUDIT LOG (administrative/destructive actions only - not routine
// sales/stock activity, which already has its own history views)
// ─────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  businessId String?
  actorId    String?
  // Denormalized snapshots so an entry stays readable even after the
  // business/actor it describes is gone - an audit trail has to outlive
  // the thing it's describing. `metadata` holds action-specific details
  // (e.g. { name: "Soap Carton" } for a delete, { fromRole, toRole } for a
  // role change).
  actorName  String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  actor    User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
}